#!/bin/sh
# [TODO: 專案名稱] pre-commit hook
#
# Enable per-clone (one-time):
#   git config core.hooksPath scripts/git-hooks
#
# Runs conditional audits so unrelated commits are unaffected;
# only relevant file changes trigger the corresponding audits.
#
# Bypass in an emergency:  git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
# TODO: 如果程式碼在子目錄（例如 app/），改成 "$REPO_ROOT/app"
APP_DIR="$REPO_ROOT"

# ============================================================
# Guard 1 — tsc --noEmit on any src/ or lib/ change
# ============================================================
if git diff --cached --name-only | grep -qE '\.(ts|tsx)$'; then
  echo "→ pre-commit: running tsc --noEmit (TS files staged)"
  cd "$APP_DIR"
  if ! npx tsc --noEmit 2>&1 | tail -20; then
    echo ""
    echo "❌ pre-commit: tsc --noEmit failed — fix TS errors or --no-verify to bypass"
    exit 1
  fi
  cd "$REPO_ROOT"
fi

# ============================================================
# Guard 1b — [TODO: 專案特定的靜態檢查]
